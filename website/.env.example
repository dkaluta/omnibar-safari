# Optional public build settings. Copy to .env to use these locally.
# PUBLIC_REPOSITORY_URL=https://github.com/your-name/omnibar-safari

# Set this after the Mac App Store listing is public.
# PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idYOUR_APP_ID

# Export ASTRO_SITE and ASTRO_BASE in the shell if overriding the Astro config.
# GitHub Actions supplies those two values from the Pages configuration.
