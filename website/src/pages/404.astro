---
import SiteLayout from '../layouts/SiteLayout.astro';
import { pageURL } from '../lib/site';
---
<SiteLayout title="Page not found — Omnibar for Safari">
  <section class="not-found wrap"><p class="eyebrow">404</p><h1>A wrong turn.</h1><p>There isn’t a page at this address.</p><a class="button" href={pageURL()}>Back to Omnibar <span aria-hidden="true">→</span></a></section>
</SiteLayout>
